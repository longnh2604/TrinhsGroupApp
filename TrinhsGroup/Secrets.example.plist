<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for TrinhsGroup/Secrets.plist, which is NOT tracked in git.

  Setup for a fresh clone:
      cp TrinhsGroup/Secrets.example.plist TrinhsGroup/Secrets.plist
  then paste the real values in.

  WOO_CONSUMER_KEY / WOO_CONSUMER_SECRET must be a READ-ONLY WooCommerce REST key.
  Generate at: WP admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key,
  with Permissions set to "Read". These credentials ship inside the app binary and are
  extractable from the IPA, so a read-only key is the only acceptable kind here — it is
  used solely for public catalog reads (products, categories).

  Everything that touches a customer, order, voucher or payment method goes through
  /wp-json/trinh-app/v1/* with the signed-in user's JWT instead. See AppSecrets.swift.
-->
<plist version="1.0">
<dict>
	<key>WOO_CONSUMER_KEY</key>
	<string>ck_REPLACE_WITH_READ_ONLY_KEY</string>
	<key>WOO_CONSUMER_SECRET</key>
	<string>cs_REPLACE_WITH_READ_ONLY_SECRET</string>
</dict>
</plist>
